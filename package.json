{
  "name": "session-combat",
  "version": "1.0.0",
  "description": "holds a combat tracker and encounters for a single DnD session",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/generate-version.js && next dev",
    "build": "node scripts/generate-version.js && next build",
    "start": "BUILD_VERSION=$(node -e \"console.log(require('./package.json').version)\") BUILD_TIME=$(date -u +'%Y-%m-%dT%H:%M:%SZ') HOSTNAME=0.0.0.0 PORT=3000 next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --testPathPattern='tests/unit' --coverage",
    "test:integration": "jest --config=jest.integration.config.js",
    "test:ci": "npm run test:integration -- --forceExit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "opsx:init-change": "sh scripts/init-change.sh",
    "postinstall": "patch-package",
    "prepare": "husky install",
    "test:regression": "playwright test tests/e2e/",
    "migrate:encounters": "npx tsx lib/scripts/backfillCampaignEncounters.ts",
    "seed": "npx tsx lib/scripts/seedCampaignTemplates.ts",
    "seed:force": "npx tsx lib/scripts/seedCampaignTemplates.ts --force",
    "seed:monsters": "npx tsx lib/scripts/seedGlobalMonsters.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@drdreo/dice-box-threejs": "1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "bcryptjs": "^3.0.3",
    "fuse.js": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mailtrap": "^4.10.0",
    "mongodb": "^6.3.0",
    "next": "^16.3.3",
    "patch-package": "^8.0.1",
    "radix-ui": "1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@bgotink/playwright-coverage": "^0.3.2",
    "@next/eslint-plugin-next": "16.3.3",
    "@playwright/test": "^1.62.1",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "^0.2.29",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/mongodb": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "cannon-es": "^0.20.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.4.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "three": "^0.176.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
