# Optional offline-first feature toggle.
# Defaults to disabled when absent; only set to true to enable offline-first data routing.
# NEXT_PUBLIC_OFFLINE_MODE_ENABLED=true

# Transactional email — Mailtrap delivery (password reset + feedback)
# MAILTRAP_TOKEN=your-mailtrap-api-token
# MAILTRAP_FROM_EMAIL=noreply@yourdomain.com
# APP_URL=https://yourdomain.com

# Feedback — in-app bug/feature reports are emailed via Mailtrap
# FEEDBACK_TO_EMAIL=feedback@yourdomain.com   # required — recipient for in-app bug/feature feedback
# GITHUB_FEEDBACK_TOKEN is no longer used (feedback no longer creates a GitHub issue)
